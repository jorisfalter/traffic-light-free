{
  "name": "traffic-light-free",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "ios:sync": "npm run build && cap sync ios",
    "ios:live:sync": "node scripts/ios-live-sync.mjs",
    "ios:open": "npm run ios:sync && cap open ios",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
